/* 指南针页 */
.compass-bar { width: 100%; margin-bottom: var(--sp-3); }
.tag-warn { color: var(--warn); }
.bearing-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--sp-5) 0;
}
.bearing-num { font-size: 108rpx; font-weight: 700; color: var(--text); line-height: 1.1; }
.bearing-name { font-size: 34rpx; color: var(--text-2); margin: var(--sp-2) 0 var(--sp-3); }
.compass-ops { width: 100%; }
.compass-btn { flex: 1; min-width: 260rpx; }
.err-bar { border-left: 8rpx solid var(--err); }
.retry-btn { margin-left: var(--sp-2); }
.compass-card { display: flex; flex-direction: column; align-items: center; padding: var(--sp-4) var(--sp-3); }
.dial-wrap { position: relative; width: 560rpx; height: 560rpx; }
.dial {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 6rpx solid var(--line);
  background: var(--surface);
  box-shadow: var(--shadow-sm);
}
.tick {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 120rpx;
  margin: -20rpx 0 0 -60rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-2);
}
.tick-n { color: var(--err); font-weight: 700; transform: translateY(-240rpx); }
.tick-e { transform: rotate(90deg) translateY(-240rpx) rotate(-90deg); }
.tick-s { transform: rotate(180deg) translateY(-240rpx) rotate(-180deg); }
.tick-w { transform: rotate(270deg) translateY(-240rpx) rotate(-270deg); }
.dial-pointer {
  position: absolute;
  top: -8rpx;
  left: 50%;
  margin-left: -16rpx;
  width: 0;
  height: 0;
  border-left: 16rpx solid transparent;
  border-right: 16rpx solid transparent;
  border-top: 28rpx solid var(--err);
}
.dial-center {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.deg-num { font-size: 64rpx; font-weight: 700; color: var(--text); }
.deg-name { font-size: 30rpx; color: var(--text-2); margin-top: var(--sp-1); }
.calib-hint {
  margin-top: var(--sp-3);
  padding: var(--sp-2) var(--sp-3);
  border-radius: var(--r-sm);
  background: var(--surface-2);
  color: var(--warn);
  width: 100%;
  text-align: center;
}
.mag-note { margin-top: var(--sp-2); width: 100%; text-align: center; }
