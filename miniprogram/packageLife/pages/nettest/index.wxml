<tool-shell toolId="life-nettest" title="网速测试" desc="下载带宽 / TTFB / 抖动" tips="{{tips}}">
  <view class="stack">
    <view class="card">
      <view class="row-between ver-row">
        <text class="t-sm t-muted">当前网络：{{netType || '检测中'}}</text>
        <text class="tag">{{sizeLabel}} ×3</text>
      </view>
      <param-form schema="{{schema}}" values="{{values}}" bind:change="onParamChange" />
    </view>

    <button class="btn btn-primary btn-block run-btn" loading="{{busy}}" disabled="{{busy}}" bindtap="onRun">
      {{busy ? '测试中…' : (result ? '重新测试' : '开始测试')}}
    </button>

    <task-progress
      wx:if="{{busy}}"
      visible="{{true}}"
      stage="{{stage}}"
      percent="{{percent}}"
      message="{{progressMessage}}"
      bind:cancel="onCancel"
    />

    <view wx:if="{{error}}" class="card err-bar">
      <text class="t-sm">{{error.message}}</text>
      <button class="btn btn-sm retry-btn" bindtap="onRun">重试</button>
    </view>

    <empty-state
      wx:if="{{!busy && !result && !error}}"
      title="尚未测速"
      desc="点击「开始测试」下载 3 份采样文件，估算当前网络的下载带宽、TTFB 与抖动"
      icon="nettest"
    />

    <result-panel
      wx:if="{{result}}"
      class="fade-up"
      kind="kv"
      kv="{{result.kv}}"
      meta="{{result.meta}}"
      text="{{result.text}}"
      showCopy="{{true}}"
      bind:copy="onCopy"
    />
  </view>
</tool-shell>
