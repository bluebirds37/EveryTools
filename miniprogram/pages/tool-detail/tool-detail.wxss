.detail {
  padding-top: var(--sp-3);
  padding-bottom: 220rpx;
}

.press {
  opacity: .72;
}

/* ---------- 工具大卡 ---------- */
.hero {
  border-radius: var(--r-lg);
  padding: var(--sp-5) var(--sp-4) var(--sp-4);
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: var(--shadow-sm);
}
.hero-icon {
  width: 168rpx;
  height: 168rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow);
}
.hero-name {
  margin-top: var(--sp-3);
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.hero-desc {
  margin-top: 10rpx;
  font-size: 27rpx;
  color: var(--text-2);
  text-align: center;
}
.hero-tags {
  margin-top: var(--sp-3);
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12rpx;
}
.hero-tag {
  height: 48rpx;
  padding: 0 20rpx;
  display: inline-flex;
  align-items: center;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: var(--surface);
  color: var(--text-2);
  box-shadow: var(--shadow-sm);
}
.hero-tag-accent {
  color: var(--on-brand);
  font-weight: 600;
  box-shadow: none;
}
.hero-tag-warn {
  color: var(--warn);
  background: rgba(245, 158, 11, 0.14);
  box-shadow: none;
}
.hero-tag-off {
  color: var(--err);
  background: rgba(229, 72, 77, 0.12);
  box-shadow: none;
}

/* ---------- 处理方式 ---------- */
.engine-card {
  margin-top: var(--sp-3);
}
.engine-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}
.engine-dot {
  width: 16rpx;
  height: 16rpx;
  flex-shrink: 0;
  margin-top: 16rpx;
  border-radius: 50%;
}
.engine-detail {
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.6;
}
.privacy-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: var(--sp-3);
  padding-top: var(--sp-3);
  border-top: 2rpx solid var(--line);
}
.privacy-label {
  font-size: 24rpx;
  color: var(--text-3);
}
.privacy-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.privacy-tag {
  height: 44rpx;
  padding: 0 18rpx;
  display: inline-flex;
  align-items: center;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--err);
  background: rgba(229, 72, 77, 0.1);
}

/* ---------- 常规卡片间距 ---------- */
.card {
  margin-top: var(--sp-3);
}
.kw-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: var(--sp-3);
  padding-top: var(--sp-3);
  border-top: 2rpx solid var(--line);
}
.kw-tag {
  height: 48rpx;
  padding: 0 18rpx;
  display: inline-flex;
  align-items: center;
  border-radius: var(--r-sm);
  font-size: 22rpx;
  background: var(--surface-2);
  color: var(--text-2);
}

/* ---------- 使用说明 ---------- */
.step-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 14rpx 0;
}
.step-index {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--brand);
  background: rgba(59, 91, 254, 0.12);
}
.step-text {
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.6;
}

/* ---------- 相关工具 ---------- */
.sec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: var(--sp-4) 4rpx var(--sp-2);
}
.sec-title {
  font-size: 30rpx;
  font-weight: 700;
}
.sec-more {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 24rpx;
  color: var(--text-2);
  padding: 12rpx 0 12rpx 16rpx;
}
.sec-arrow {
  font-size: 30rpx;
  line-height: 1;
  color: var(--text-3);
}
.grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: var(--sp-2);
}
.rcard {
  min-width: 0;
  background: var(--surface);
  border-radius: var(--r-md);
  box-shadow: var(--shadow-sm);
  padding: 20rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  transition: transform .15s ease;
}
.rcard:active {
  transform: scale(.96);
}
.rcard-icon {
  width: 78rpx;
  height: 78rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.rcard-name {
  width: 100%;
  text-align: center;
  font-size: 23rpx;
  font-weight: 600;
}

/* ---------- 工具编号 ---------- */
.tool-id {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-top: var(--sp-4);
  color: var(--text-3);
}
.tool-id-text {
  font-size: 22rpx;
}

/* ---------- 底部操作区 ---------- */
.action {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 8;
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  padding: 18rpx 28rpx calc(env(safe-area-inset-bottom) + 18rpx);
  background: var(--surface);
  box-shadow: 0 -6rpx 24rpx rgba(23, 26, 33, 0.06);
}
.action-fav {
  width: 132rpx;
  height: 96rpx;
  flex-shrink: 0;
  border-radius: var(--r-md);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  background: var(--surface-2);
  color: var(--text-2);
}
.action-fav-on {
  background: rgba(245, 158, 11, 0.14);
}
.action-fav-text {
  font-size: 22rpx;
}
.action-use {
  flex: 1;
  height: 96rpx;
  font-size: 32rpx;
}
.action-use-off {
  background: var(--surface-2);
  color: var(--text-3);
  box-shadow: none;
}

/* ---------- 工具不存在 ---------- */
.detail-missing {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: var(--sp-5);
}
.missing-btn {
  margin-top: var(--sp-3);
  padding: 0 48rpx;
}
