<view wx:if="{{loading}}" class="card rp-skeleton">
  <view class="sk sk-line" />
  <view class="sk sk-block" />
  <view class="sk sk-line sk-w60" />
</view>

<view wx:elif="{{kind !== 'none'}}" class="card rp fade-up">
  <!-- 图片：单图（可前后对比）/ 多图网格 -->
  <block wx:if="{{kind === 'image'}}">
    <slider-compare wx:if="{{compare && primary}}" before="{{compareBefore}}" after="{{primary.url}}" />
    <image wx:elif="{{primary}}" class="rp-img" src="{{primary.url}}" mode="widthFix" data-url="{{primary.url}}" bindtap="onPreview" />
  </block>

  <block wx:elif="{{kind === 'images'}}">
    <view class="rp-grid">
      <view wx:for="{{list}}" wx:key="url" class="rp-cell" data-url="{{item.url}}" bindtap="onPreview">
        <image class="rp-cell-img" src="{{item.url}}" mode="aspectFill" />
        <view wx:if="{{item.label}}" class="rp-cell-label ellipsis">{{item.label}}</view>
      </view>
    </view>
  </block>

  <video wx:elif="{{kind === 'video' && video}}" class="rp-video" src="{{video}}" controls show-center-play-btn object-fit="contain" />

  <block wx:elif="{{kind === 'text'}}">
    <view class="row-between rp-text-head">
      <text class="t-sm t-muted">{{text.length}} 字</text>
      <view class="tag rp-wrap" hover-class="none" bindtap="onToggleWrap">{{wrap ? '自动换行' : '不换行'}}</view>
    </view>
    <scroll-view scroll-x="{{!wrap}}" scroll-y="{{wrap}}" class="code-block rp-text {{wrap ? '' : 'rp-nowrap'}}">{{text}}</scroll-view>
  </block>

  <block wx:elif="{{kind === 'kv'}}">
    <view class="rp-kv">
      <view wx:for="{{rows}}" wx:key="key" class="kv-row">
        <text class="kv-key">{{item.key}}</text>
        <text class="kv-val t-mono">{{item.value}}</text>
      </view>
    </view>
  </block>

  <view wx:if="{{meta}}" class="rp-meta t-sm t-muted">{{meta}}</view>

  <view wx:if="{{showCopy || showSave || showShare || actions.length}}" class="row wrap rp-actions">
    <view wx:if="{{showCopy}}" class="btn btn-sm rp-btn" hover-class="none" bindtap="onCopy">
      <grid-icon name="copy" size="34" />
      <text class="rp-btn-t">复制</text>
    </view>
    <view wx:if="{{showSave}}" class="btn btn-sm rp-btn" hover-class="none" bindtap="onSave">
      <grid-icon name="save" size="34" />
      <text class="rp-btn-t">保存</text>
    </view>
    <view wx:if="{{showShare}}" class="btn btn-sm rp-btn" hover-class="none" bindtap="onShare">
      <grid-icon name="share" size="34" />
      <text class="rp-btn-t">分享</text>
    </view>
    <view wx:for="{{actions}}" wx:key="toolId" class="btn btn-sm btn-ghost rp-btn" hover-class="none" data-tool="{{item.toolId}}" bindtap="onAction">
      <text class="rp-btn-t">{{item.label || '继续处理'}}</text>
    </view>
  </view>
</view>
