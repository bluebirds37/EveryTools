.mp-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--sp-2);
}
.mp-cell,
.mp-add {
  position: relative;
  height: 200rpx;
  border-radius: var(--r-md);
  overflow: hidden;
}
.mp-cell {
  background: var(--surface-2);
}
.mp-thumb {
  width: 100%;
  height: 100%;
  display: block;
}
.mp-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--sp-1);
  border: 2rpx dashed var(--text-3);
  color: var(--text-2);
  background: var(--surface);
}
.mp-add:active {
  border-color: var(--brand);
  color: var(--brand);
}
.mp-add-t {
  font-size: 22rpx;
}
.mp-disabled {
  opacity: .55;
}
.mp-badge {
  position: absolute;
  height: 36rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, .5);
  color: var(--on-brand);
  font-size: 22rpx;
  display: flex;
  align-items: center;
  max-width: 78%;
}
.mp-badge-play {
  left: 10rpx;
  top: 10rpx;
  padding: 0 8rpx;
}
.mp-badge-info {
  left: 10rpx;
  bottom: 10rpx;
}
/* 触控热区 88rpx，视觉是小圆点 */
.mp-del {
  position: absolute;
  right: -14rpx;
  top: -14rpx;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: flex-start;
  justify-content: flex-end;
}
.mp-del-in {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, .55);
  display: flex;
  align-items: center;
  justify-content: center;
}
.mp-foot {
  margin-top: var(--sp-2);
}
.mp-foot:empty {
  display: none;
}
