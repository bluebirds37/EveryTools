.es {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--sp-5) var(--sp-4);
  text-align: center;
}
.es-compact {
  padding: var(--sp-4) var(--sp-3);
}
.es-icon {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--surface-2);
  margin-bottom: var(--sp-3);
}
.es-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}
.es-desc {
  margin-top: var(--sp-1);
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.6;
  max-width: 520rpx;
}
.es-action {
  margin-top: var(--sp-3);
}
.es-action:empty {
  display: none;
}
