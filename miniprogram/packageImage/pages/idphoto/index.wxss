.offscreen {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 300px;
  height: 300px;
}

.crop-card { padding: var(--sp-4) var(--sp-3); }
.card-title.no-mb { margin-bottom: 0; }

.stage {
  position: relative;
  width: 100%;
  height: 660rpx;
  margin-top: var(--sp-3);
  border-radius: var(--r-lg);
  overflow: hidden;
  background: var(--stage);
  touch-action: none;
}

.stage-img { position: absolute; transform-origin: 50% 50%; }
.stage-tag {
  position: absolute;
  left: var(--sp-2);
  bottom: var(--sp-2);
  font-size: 22rpx;
  color: rgba(255, 255, 255, .8);
  background: rgba(0, 0, 0, .45);
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.mask { position: absolute; background: rgba(6, 8, 12, .68); }
.mask-top { left: 0; right: 0; top: 0; }
.mask-bottom { left: 0; right: 0; bottom: 0; }
.mask-left { left: 0; }
.mask-right { right: 0; }

.frame { position: absolute; border: 2rpx solid rgba(255, 255, 255, .9); }

.guide { position: absolute; left: 0; right: 0; height: 1rpx; background: rgba(34, 195, 214, .55); }
.head-top { top: 12%; }
.chin { top: 32%; }
.center {
  left: 50%;
  right: auto;
  top: 0;
  bottom: 0;
  width: 1rpx;
  height: auto;
  background: rgba(34, 195, 214, .35);
}

.meta-row { margin-top: var(--sp-2); }

.note-info,
.note-warn {
  border-radius: var(--r-md);
  padding: var(--sp-2);
  font-size: 24rpx;
  line-height: 1.5;
  margin-top: var(--sp-2);
}

.note-info { background: var(--surface-2); color: var(--text-2); }
.note-warn { background: rgba(245, 158, 11, .12); color: var(--warn); }

.err-card { border: 2rpx solid rgba(229, 72, 77, .35); }
.err-text { color: var(--err); }

.out-img {
  width: 320rpx;
  border-radius: var(--r-md);
  background: var(--surface-2);
  margin: var(--sp-2) 0 var(--sp-3);
}
