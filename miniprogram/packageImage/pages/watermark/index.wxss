.offscreen {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 300px;
  height: 300px;
}

.logo-box { margin-top: var(--sp-3); display: flex; flex-direction: column; gap: var(--sp-2); }

.pos-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--sp-2);
  margin-top: var(--sp-2);
}

.pos-cell {
  height: 88rpx;
  border-radius: var(--r-sm);
  background: var(--surface-2);
  border: 2rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform .12s ease;
}

.pos-cell:active { transform: scale(.96); }
.pos-cell.active {
  background: rgba(59, 91, 254, .12);
  border-color: var(--brand);
}

.pos-label { font-size: 24rpx; color: var(--text-2); }
.pos-cell.active .pos-label { color: var(--brand); font-weight: 600; }

.note-warn,
.note-info {
  border-radius: var(--r-md);
  padding: var(--sp-2);
  font-size: 24rpx;
  line-height: 1.5;
  margin-top: var(--sp-2);
}

.note-warn { background: rgba(245, 158, 11, .12); color: var(--warn); }
.note-info { background: var(--surface-2); color: var(--text-2); }

.flat-card { background: var(--surface-2); border-radius: var(--r-md); }
.bar { height: 10rpx; border-radius: 999rpx; background: var(--line); overflow: hidden; margin-top: var(--sp-2); }
.bar-in { height: 100%; border-radius: 999rpx; background: var(--brand-grad); transition: width .25s ease; }

.err-card { border: 2rpx solid rgba(229, 72, 77, .35); }
.err-text { color: var(--err); }

.override-card { border: 2rpx solid var(--brand); }

.thumb-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: var(--sp-2);
}

.thumb { position: relative; aspect-ratio: 1; border-radius: var(--r-sm); overflow: hidden; background: var(--stage); }
.thumb-img { width: 100%; height: 100%; }
.thumb-fail { border: 2rpx solid var(--err); }
.thumb-fail-in { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }

.ov {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 44rpx;
  background: rgba(0, 0, 0, .58);
  display: flex;
  align-items: center;
  justify-content: center;
}

.ov-text { font-size: 20rpx; color: var(--on-brand); }
