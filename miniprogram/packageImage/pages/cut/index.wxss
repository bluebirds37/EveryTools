.offscreen {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 300px;
  height: 300px;
}

.plan-row { margin-top: var(--sp-2); }

.cols-row { display: flex; flex-direction: column; gap: var(--sp-2); }
.cols-label { font-size: 24rpx; color: var(--text-2); }

.mock {
  display: grid;
  gap: 6rpx;
  height: 260rpx;
  border-radius: var(--r-md);
  overflow: hidden;
  background: var(--stage);
  padding: 6rpx;
}

.mock-cell {
  background: rgba(59, 91, 254, .18);
  border: 2rpx dashed rgba(255, 255, 255, .25);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mock-no { font-size: 22rpx; color: var(--on-brand); opacity: .85; }

.err-card { border: 2rpx solid rgba(229, 72, 77, .35); }
.err-text { color: var(--err); }
.t-ok { color: var(--ok); }

.cell-grid {
  display: grid;
  gap: var(--sp-2);
  margin-bottom: var(--sp-3);
}

.cell-item { position: relative; aspect-ratio: 1; border-radius: var(--r-sm); overflow: hidden; background: var(--stage); }
.cell-img { width: 100%; height: 100%; }
.cell-no {
  position: absolute;
  left: 8rpx;
  top: 8rpx;
  min-width: 34rpx;
  height: 34rpx;
  border-radius: 999rpx;
  background: var(--brand);
  color: var(--on-brand);
  font-size: 20rpx;
  line-height: 34rpx;
  text-align: center;
}

.save-row { margin-top: var(--sp-2); }
