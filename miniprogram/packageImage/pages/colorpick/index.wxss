.offscreen {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 300px;
  height: 300px;
}

.card-title.no-mb { margin-bottom: 0; }
.pick-card { padding: var(--sp-4) var(--sp-3); }

.stage {
  position: relative;
  width: 100%;
  height: 620rpx;
  margin-top: var(--sp-3);
  border-radius: var(--r-lg);
  overflow: hidden;
  background: var(--stage);
  touch-action: none;
}

.stage-img { position: absolute; }

.cross { position: absolute; width: 0; height: 0; pointer-events: none; }
.cross-h { position: absolute; left: -60rpx; top: 0; width: 120rpx; height: 2rpx; background: rgba(34, 195, 214, .9); }
.cross-v { position: absolute; top: -60rpx; left: 0; height: 120rpx; width: 2rpx; background: rgba(34, 195, 214, .9); }
.cross-dot {
  position: absolute;
  left: -14rpx;
  top: -14rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 3rpx solid var(--on-brand);
  box-shadow: 0 0 0 2rpx rgba(0, 0, 0, .35);
}

.lens-row { margin-top: var(--sp-3); align-items: flex-start; }
.lens {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--r-sm);
  background: var(--stage);
  border: 2rpx solid var(--line);
}

.swatch-big {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--r-sm);
  border: 2rpx solid var(--line);
}

.fmt-row {
  padding: 10rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.fmt-row:last-child { border-bottom: none; }
.fmt-val { font-size: 26rpx; color: var(--text); }

.pal-strip { display: flex; height: 160rpx; border-radius: var(--r-md); overflow: hidden; gap: 4rpx; margin: var(--sp-2) 0 var(--sp-3); }
.pal-cell { display: flex; align-items: flex-end; justify-content: center; min-width: 60rpx; padding-bottom: 8rpx; }
.pal-ratio { font-size: 20rpx; color: rgba(255, 255, 255, .9); text-shadow: 0 1rpx 3rpx rgba(0, 0, 0, .6); }

.pal-list { display: flex; flex-direction: column; }
.pal-row { padding: 14rpx 0; border-bottom: 2rpx solid var(--line); }
.pal-row:last-child { border-bottom: none; }
.dot { width: 32rpx; height: 32rpx; border-radius: 8rpx; border: 2rpx solid var(--line); margin-right: var(--sp-1); }

.shade-row { display: flex; flex-direction: column; gap: var(--sp-2); }
.shade-list { display: flex; gap: 6rpx; }
.shade { flex: 1; height: 88rpx; border-radius: 12rpx; display: flex; align-items: flex-end; justify-content: center; }
.shade-l { font-size: 20rpx; color: rgba(255, 255, 255, .85); text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, .5); }

.cc-row { align-items: flex-start; gap: var(--sp-3); }
.cc-box { flex: 1; display: flex; flex-direction: column; gap: var(--sp-1); }
.cc-input { height: 72rpx; }
.swatch-sm { height: 56rpx; border-radius: var(--r-sm); border: 2rpx solid var(--line); }
.cc-action { margin: var(--sp-2) 0; }

.demo {
  border-radius: var(--r-md);
  padding: var(--sp-4);
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
  border: 2rpx solid var(--line);
}
.demo-lg { font-size: 44rpx; font-weight: 700; }
.demo-sm { font-size: 26rpx; }

.cc-result { margin-top: var(--sp-3); display: flex; flex-direction: column; gap: var(--sp-2); }
.wcag-row { gap: var(--sp-1); }
.tag-pass { background: rgba(22, 163, 74, .14); color: var(--ok); }
.tag-fail { background: rgba(229, 72, 77, .12); color: var(--err); }

.err-card { border: 2rpx solid rgba(229, 72, 77, .35); }
.err-text { color: var(--err); }
