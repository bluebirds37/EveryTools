.offscreen {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 300px;
  height: 300px;
}

.order-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: var(--sp-2);
  margin-top: var(--sp-3);
}

.order-cell {
  position: relative;
  aspect-ratio: 1;
  border-radius: var(--r-sm);
  overflow: hidden;
  background: var(--stage);
}

.order-img { width: 100%; height: 100%; }

.order-no {
  position: absolute;
  left: 8rpx;
  top: 8rpx;
  min-width: 34rpx;
  height: 34rpx;
  border-radius: 999rpx;
  background: var(--brand);
  color: var(--on-brand);
  font-size: 20rpx;
  line-height: 34rpx;
  text-align: center;
}

.order-del {
  position: absolute;
  right: 6rpx;
  bottom: 6rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, .55);
  display: flex;
  align-items: center;
  justify-content: center;
}

.plan-row { margin-top: var(--sp-2); }

.note-warn {
  border-radius: var(--r-md);
  padding: var(--sp-2);
  font-size: 24rpx;
  background: rgba(245, 158, 11, .12);
  color: var(--warn);
  margin-top: var(--sp-2);
}

.err-card { border: 2rpx solid rgba(229, 72, 77, .35); }
.err-text { color: var(--err); }

.out-img {
  width: 100%;
  border-radius: var(--r-md);
  background: var(--stage);
  margin-bottom: var(--sp-2);
}
