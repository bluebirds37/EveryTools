.offscreen {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 300px;
  height: 300px;
}

.batch-tip { margin-top: var(--sp-2); }

.exif-row,
.cloud-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
  padding: var(--sp-2) 0;
}

.exif-left { display: flex; flex-direction: column; gap: 4rpx; }
.exif-label { font-size: 28rpx; font-weight: 600; }

.switch,
.switch-off {
  width: 92rpx;
  height: 52rpx;
  border-radius: 999rpx;
  background: var(--surface-2);
  border: 2rpx solid var(--line);
  display: flex;
  align-items: center;
  padding: 4rpx;
  flex-shrink: 0;
}

.switch.on { background: var(--brand-grad); border-color: transparent; }
.switch.disabled,
.switch-off { opacity: .45; }

.switch-knob {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: var(--surface);
  box-shadow: var(--shadow-sm);
  transition: transform .18s ease;
}

.switch.on .switch-knob { transform: translateX(40rpx); }
.switch-knob.off { transform: none; }

.note-warn,
.note-info {
  display: flex;
  align-items: flex-start;
  gap: var(--sp-1);
  border-radius: var(--r-md);
  padding: var(--sp-2);
  font-size: 24rpx;
  line-height: 1.5;
  margin: var(--sp-2) 0;
}

.note-warn { background: rgba(245, 158, 11, .12); color: var(--warn); }
.note-info { background: var(--surface-2); color: var(--text-2); }

.flat-card { background: var(--surface-2); border-radius: var(--r-md); }
.bar { height: 10rpx; border-radius: 999rpx; background: var(--line); overflow: hidden; margin-top: var(--sp-2); }
.bar-in { height: 100%; border-radius: 999rpx; background: var(--brand-grad); transition: width .25s ease; }

.err-card { border: 2rpx solid rgba(229, 72, 77, .35); }
.err-text { color: var(--err); }

.metric { gap: var(--sp-2); margin-bottom: var(--sp-3); }
.metric-item {
  flex: 1;
  min-width: 180rpx;
  background: var(--surface-2);
  border-radius: var(--r-md);
  padding: var(--sp-3) var(--sp-2);
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.metric-item.accent { background: rgba(59, 91, 254, .1); }
.metric-item.accent .m-val { color: var(--brand); }
.m-val { font-size: 32rpx; font-weight: 700; font-family: "SF Mono", Menlo, monospace; }
.m-key { font-size: 22rpx; color: var(--text-2); }

.thumb-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: var(--sp-2);
  margin-top: var(--sp-3);
}

.thumb {
  position: relative;
  aspect-ratio: 1;
  border-radius: var(--r-sm);
  overflow: hidden;
  background: var(--surface-2);
}
.thumb-img { width: 100%; height: 100%; }
.thumb-fail-in { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }
.thumb-fail { border: 2rpx solid var(--err); }
.badge {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--ok);
  box-shadow: 0 0 0 4rpx rgba(22, 163, 74, .25);
}
.thumb-size {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  text-align: center;
  font-size: 20rpx;
  padding: 4rpx 0;
  background: rgba(0, 0, 0, .55);
  color: var(--on-brand);
}

.next-card { display: flex; flex-direction: column; gap: var(--sp-2); }
.gap-row { gap: var(--sp-2); }
.gap-row .tag { height: 60rpx; padding: 0 24rpx; font-size: 24rpx; }
