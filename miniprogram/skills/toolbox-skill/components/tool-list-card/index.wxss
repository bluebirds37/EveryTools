.tlc { padding: 24rpx; border-radius: 28rpx; background: var(--card, #fff); }
.tlc-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 16rpx; }
.tlc-title { font-size: 30rpx; font-weight: 600; color: var(--text, #1F2430); }
.tlc-count { font-size: 22rpx; color: var(--text-3, #8A93A6); }
.tlc-item { display: flex; align-items: center; min-height: 88rpx; padding: 12rpx 8rpx; }
.tlc-item:active { transform: scale(0.98); }
.tlc-dot { width: 16rpx; height: 16rpx; border-radius: 50%; margin-right: 16rpx; flex-shrink: 0; }
.tlc-info { flex: 1; display: flex; flex-direction: column; overflow: hidden; }
.tlc-name { font-size: 28rpx; color: var(--text, #1F2430); }
.tlc-desc { font-size: 22rpx; color: var(--text-3, #8A93A6); margin-top: 4rpx; }
.tlc-cat { font-size: 22rpx; color: var(--text-3, #8A93A6); }
.tlc-more { text-align: center; padding: 20rpx 0 8rpx; font-size: 26rpx; color: #3B5BFE; }
.tlc-empty { padding: 32rpx 0; text-align: center; font-size: 24rpx; color: var(--text-3, #8A93A6); }
