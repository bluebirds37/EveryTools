<tool-shell toolId="text-naming" title="命名转换" desc="驼峰下划线命名互转" tips="{{tips}}">
  <view class="stack">
    <view class="card">
      <view class="field-label">
        <text>输入（多行按行处理）</text>
        <text class="t-dim t-sm">{{input.length}} 字</text>
      </view>
      <textarea class="textarea" placeholder="如 user_nameHTTPCode" value="{{input}}" bindinput="onInput" maxlength="-1" auto-height="{{false}}" />
      <view class="row wrap input-actions">
        <button class="btn btn-ghost btn-sm" bindtap="onPaste">粘贴</button>
        <button class="btn btn-sm" bindtap="onClearInput">清空</button>
      </view>
    </view>

    <view class="card">
      <param-form schema="{{schema}}" values="{{values}}" bind:change="onParamChange" />
    </view>

    <button class="btn btn-primary btn-block" bindtap="onRun" loading="{{busy}}" disabled="{{busy}}">转换</button>

    <view wx:if="{{error}}" class="card err-bar">
      <view class="err-msg">{{error.message}}</view>
      <view class="t-dim t-sm err-code">{{error.code}}</view>
    </view>

    <view wx:if="{{result && tokensText}}" class="card fade-up">
      <view class="kv-row">
        <text class="kv-key">拆词</text>
        <text class="kv-val t-mono">{{tokensText}}</text>
      </view>
      <view class="kv-row">
        <text class="kv-key">识别风格</text>
        <text class="kv-val">{{detected}}</text>
      </view>
    </view>

    <view wx:if="{{result && styleRows.length}}" class="card fade-up">
      <view class="card-title">六种风格同屏（点击复制）</view>
      <view
        wx:for="{{styleRows}}"
        wx:key="key"
        class="style-row {{item.active ? 'style-active' : ''}}"
        data-value="{{item.value}}"
        bindtap="onCopyStyle"
      >
        <text class="style-label t-dim t-sm">{{item.label}}</text>
        <text class="style-value t-mono">{{item.value}}</text>
      </view>
    </view>

    <result-panel
      wx:if="{{result}}"
      class="fade-up"
      kind="text"
      text="{{result.text}}"
      meta="{{result.meta}}"
      showCopy="{{true}}"
      showShare="{{true}}"
      bind:copy="onCopy"
      bind:share="onShare"
    />

    <empty-state
      wx:if="{{!result && !error}}"
      icon="naming"
      title="等待输入"
      desc="camelCase / snake_case / kebab / CONSTANT / Title 互转"
    />

    <view class="card">
      <view class="card-title">内置示例（一键验证）</view>
      <view class="wrap">
        <button wx:for="{{samples}}" wx:key="name" class="btn btn-sm sample-btn" data-index="{{index}}" bindtap="onSample">{{item.name}}</button>
      </view>
    </view>
  </view>
</tool-shell>
