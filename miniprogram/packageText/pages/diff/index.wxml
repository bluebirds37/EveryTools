<tool-shell toolId="text-diff" title="文本对比" desc="两段文本逐行找不同" tips="{{tips}}">
  <view class="stack">
    <view class="card">
      <view class="field-label">
        <text>左侧文本（基准）</text>
        <text class="t-dim t-sm">{{left.length}} 字</text>
      </view>
      <textarea class="textarea diff-input" placeholder="粘贴或输入基准文本" value="{{left}}" bindinput="onLeft" maxlength="-1" auto-height="{{false}}" />
      <view class="row wrap input-actions">
        <button class="btn btn-ghost btn-sm" bindtap="onPasteLeft">粘贴左</button>
        <button class="btn btn-sm" bindtap="onSwap">交换左右</button>
        <button class="btn btn-sm" bindtap="onClearAll">清空</button>
      </view>
    </view>

    <view class="card">
      <view class="field-label">
        <text>右侧文本（对比）</text>
        <text class="t-dim t-sm">{{right.length}} 字</text>
      </view>
      <textarea class="textarea diff-input" placeholder="粘贴或输入对比文本" value="{{right}}" bindinput="onRight" maxlength="-1" auto-height="{{false}}" />
      <view class="row wrap input-actions">
        <button class="btn btn-ghost btn-sm" bindtap="onPasteRight">粘贴右</button>
      </view>
    </view>

    <view class="card">
      <param-form schema="{{schema}}" values="{{values}}" bind:change="onParamChange" />
    </view>

    <button class="btn btn-primary btn-block" bindtap="onRun" loading="{{busy}}" disabled="{{busy}}">开始对比</button>

    <view wx:if="{{error}}" class="card err-bar">
      <view class="err-msg">{{error.message}}</view>
      <view class="t-dim t-sm err-code">{{error.code}}</view>
    </view>

    <view wx:if="{{diffOut}}" class="card kv-card fade-up">
      <view wx:for="{{statRows}}" wx:key="k" class="kv-row">
        <text class="kv-key">{{item.k}}</text>
        <text class="kv-val t-mono stat-{{item.c}}">{{item.v}}</text>
      </view>
    </view>

    <view wx:if="{{diffOut && values.view === 'split'}}" class="card fade-up">
      <view class="card-title">左右分栏{{diffOut.truncated ? '（展示前 500 行）' : ''}}</view>
      <view wx:for="{{diffOut.rows}}" wx:key="index" class="d-row d-{{item.type}}">
        <view class="d-cell d-left">
          <text class="d-no t-mono">{{item.lineA || ''}}</text>
          <text wx:if="{{item.type === 'eq'}}" class="d-txt">{{item.text}}</text>
          <text wx:if="{{item.type === 'del'}}" class="d-txt d-del-txt">{{item.text}}</text>
          <text wx:if="{{item.type === 'mod'}}" class="d-txt d-del-txt">{{item.textA}}</text>
        </view>
        <view class="d-cell d-right">
          <text class="d-no t-mono">{{item.lineB || ''}}</text>
          <text wx:if="{{item.type === 'eq'}}" class="d-txt">{{item.text}}</text>
          <text wx:if="{{item.type === 'add'}}" class="d-txt d-add-txt">{{item.text}}</text>
          <text wx:if="{{item.type === 'mod'}}" class="d-txt d-add-txt">{{item.textB}}</text>
        </view>
      </view>
    </view>

    <result-panel
      wx:if="{{result && values.view === 'unified'}}"
      class="fade-up"
      kind="text"
      text="{{result.text}}"
      meta="{{result.meta}}"
      showCopy="{{true}}"
      showShare="{{true}}"
      bind:copy="onCopy"
      bind:share="onShare"
    />
    <view wx:if="{{result && values.view === 'split'}}" class="card fade-up patch-card" bindtap="onCopyPatch">
      <view class="card-title">unified 补丁（点击复制）</view>
      <view class="code-block patch-block">{{result.text}}</view>
    </view>

    <empty-state
      wx:if="{{!result && !error}}"
      icon="diff"
      title="等待两段文本"
      desc="行 / 词 / 字符三种粒度，左右分栏与 unified 补丁视图"
    />

    <view class="card">
      <view class="card-title">内置示例（一键验证）</view>
      <view class="wrap">
        <button wx:for="{{samples}}" wx:key="name" class="btn btn-sm sample-btn" data-index="{{index}}" bindtap="onSample">{{item.name}}</button>
      </view>
    </view>
  </view>
</tool-shell>
