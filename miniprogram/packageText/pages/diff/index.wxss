/* 文本对比页：仅本页特有样式 */
.diff-input { min-height: 200rpx; }
.input-actions { margin-top: var(--sp-2); }
.input-actions .btn { margin: 0 var(--sp-1) var(--sp-1) 0; }
.d-row { display: flex; border-bottom: 2rpx solid var(--line); }
.d-row:last-child { border-bottom: none; }
.d-cell { flex: 1; min-width: 0; display: flex; align-items: flex-start; padding: var(--sp-1) var(--sp-2); }
.d-left { border-right: 2rpx solid var(--line); }
.d-no { width: 56rpx; flex-shrink: 0; font-size: 20rpx; color: var(--text-3); }
.d-txt { font-size: 24rpx; line-height: 1.5; word-break: break-all; white-space: pre-wrap; }
.d-del { background: var(--surface-2); }
.d-add { background: var(--surface-2); }
.d-del-txt { color: var(--err); }
.d-add-txt { color: var(--ok); }
.d-mod .d-left { box-shadow: inset 8rpx 0 0 0 var(--warn); }
.d-mod .d-right { box-shadow: inset 8rpx 0 0 0 var(--warn); }
.stat-ok { color: var(--ok); }
.stat-err { color: var(--err); }
.stat-warn { color: var(--warn); }
.patch-card { margin-top: 0; }
.patch-block { white-space: pre-wrap; font-size: 22rpx; max-height: 480rpx; overflow-y: auto; }
.err-bar { border-left: 8rpx solid var(--err); }
.err-msg { white-space: pre-wrap; font-size: 26rpx; line-height: 1.6; }
.err-code { margin-top: var(--sp-1); }
.sample-btn { margin: 0 var(--sp-2) var(--sp-2) 0; }
