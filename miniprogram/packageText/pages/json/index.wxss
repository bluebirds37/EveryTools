/* JSON 格式化页：仅本页特有样式 */
.input-actions { margin-top: var(--sp-2); }
.err-bar { border-left: 8rpx solid var(--err); }
.err-msg { white-space: pre-wrap; font-size: 26rpx; line-height: 1.6; }
.err-code { margin-top: var(--sp-1); }
.tree-head { margin-bottom: var(--sp-2); }
.tree-scroll { max-height: 720rpx; }
.tree-row {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  min-height: 60rpx;
  padding-right: var(--sp-2);
}
.tree-toggle {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--surface-2);
  color: var(--brand);
  font-weight: 700;
  flex-shrink: 0;
}
.tree-toggle.invisible { visibility: hidden; }
.tree-key { color: var(--brand); flex-shrink: 0; max-width: 420rpx; }
.tree-type { color: var(--text-3); font-size: 22rpx; flex-shrink: 0; }
.tree-preview { color: var(--text-2); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.tree-hint { margin-top: var(--sp-2); }
.sample-btn { margin: 0 var(--sp-2) var(--sp-2) 0; }
