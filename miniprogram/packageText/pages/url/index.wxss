/* URL 编解码页：仅本页特有样式 */
.input-actions { margin-top: var(--sp-2); }
.input-actions .btn { margin: 0 var(--sp-1) var(--sp-1) 0; }
.err-bar { border-left: 8rpx solid var(--err); }
.err-msg { white-space: pre-wrap; font-size: 26rpx; line-height: 1.6; }
.err-code { margin-top: var(--sp-1); }
.param-row {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  margin-bottom: var(--sp-2);
}
.p-key { flex: 2; }
.p-val { flex: 3; }
.p-del {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--surface-2);
  color: var(--err);
  font-size: 36rpx;
  flex-shrink: 0;
}
.sample-btn { margin: 0 var(--sp-2) var(--sp-2) 0; }
