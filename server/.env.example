# =================================================================-----------
# toolbox-server 环境变量样例（docs/requirements.md 附录 B + §8.5）
#
# 用法：cp .env.example .env  然后填真实值。
# ⚠️ 铁律：本文件只放**占位符**；真实 .env 绝不提交（已在 .gitignore/.dockerignore 排除），
#          密钥只从环境变量注入，代码里没有默认值、也不会写进日志（Settings 不实现 Debug）。
#
# 优先级：环境变量 > config.toml（可选，仅非密钥项）> .env（dotenvy）> 代码默认值。
# 每个键也支持 `TB_` 前缀别名（src/config.rs::env_raw，如 TB_PORT=9000）。
# 大小写敏感；bool 项接受 1/true/TRUE/yes/on 为真，其他值为假；空值视为「未设置」。
# =================================================================-----------

# ---------------------------------------------------------------------------
# 一、server / 运行时
# ---------------------------------------------------------------------------

# 监听端口（默认 8080）。生产可由网关覆盖，非必填。
PORT=8080

# 绑定地址：容器内保持 0.0.0.0；本机开发可 127.0.0.1（默认 0.0.0.0）。
HOST=0.0.0.0

# tracing 日志级别：error/warn/info/debug/trace（默认 info）。非必填。
LOG_LEVEL=info

# 运行环境：dev | staging | prod（默认 dev）。生产建议显式写 prod。
# 注意：prod 下 WECHAT_STUB / MEDIA_DRY_RUN / PROXY_ALLOW_PRIVATE_NETWORK 必须为 0/false。
ENVIRONMENT=prod

# CORS 允许的来源，逗号分隔；小程序请求不带 Origin，留空即不下发 CORS 头（默认空）。
# 仅当有 Web 管理端等浏览器调用时才填（非必填）。
CORS_ALLOWED_ORIGINS=

# 单请求整体超时秒数（TimeoutLayer，默认 30）。大文件上传走网关时可能需要放大。
REQUEST_TIMEOUT_SECS=30

# ---------------------------------------------------------------------------
# 二、数据库
# ---------------------------------------------------------------------------

# 【必填·密钥】PostgreSQL 连接串，仅从环境变量注入，切勿提交真实值。
# 本机开发参考：postgres://postgre:postgre@127.0.0.1:15433/toolbox_dev
# docker compose 部署：主机名必须是 pg（compose 会用 POSTGRES_* 拼出 DATABASE_URL 覆盖本行）。
# 迁移由应用启动时自动执行（src/db.rs::migrate → sqlx::migrate!，SQL 已编进二进制）。
DATABASE_URL=postgres://CHANGE_ME_USER:CHANGE_ME_PASSWORD@CHANGE_ME_HOST:5432/CHANGE_ME_DB

# 连接池上限（默认 8）。非必填；单容器建议 ≤ PG max_connections / 实例数。
DB_MAX_CONNECTIONS=8

# ---------------------------------------------------------------------------
# 三、鉴权（微信登录 + JWT）
# ---------------------------------------------------------------------------

# 小程序 AppID。WECHAT_STUB=0 时【必填】（validate() 会拒绝空值）。非密钥，可入库。
WECHAT_APPID=wxCHANGE_ME_APPID

# 【必填·密钥】小程序 AppSecret：仅从环境变量注入，切勿提交真实值。
# 绝不能出现在小程序包内（requirements §6.1）。
WECHAT_APPSECRET=CHANGE_ME_ONLY_FROM_ENV

# 本地联调开关：1=不请求微信，用 code 派生本地 openid（默认 0）。
# ⚠️ 生产必须为 0，否则等同伪造 openid。
WECHAT_STUB=0

# code2session 接口地址（默认 https://api.weixin.qq.com/sns/jscode2session）。非必填。
WECHAT_CODE2SESSION_URL=https://api.weixin.qq.com/sns/jscode2session

# 【必填·密钥】JWT 签名密钥：至少 32 字节，validate() 会硬性检查。
# 仅从环境变量注入，切勿提交真实值。生成：openssl rand -hex 32
JWT_SECRET=CHANGE_ME_AT_LEAST_32_BYTES_RANDOM_SECRET

# 访问令牌有效期秒数（默认 7200 = 2h）。非必填。
ACCESS_TTL=7200

# 刷新令牌有效期秒数（默认 2592000 = 30d）。非必填；库里只存其 hash。
REFRESH_TTL=2592000

# ---------------------------------------------------------------------------
# 四、文件与存储
# ---------------------------------------------------------------------------

# 上传/产物存储目录。默认 ./data/uploads；容器内为 /data/uploads（compose 挂命名卷）。
STORAGE_DIR=/data/uploads

# 静态测速文件目录，默认 ./data/static；缺失时 GET /static/speedtest-*.bin 会 404，
# 用 scripts/gen_speedtest_files.sh 生成（镜像已内置）。
STATIC_DIR=/data/static

# 文件保留小时数（TTL 清理任务，默认 24）。非必填。
FILE_TTL_HOURS=24

# 单文件大小上限字节（默认 209715200 = 200MB，同时作为 RequestBodyLimit）。
MAX_UPLOAD_BYTES=209715200

# 分片大小字节（默认 4194304 = 4MB）。必须 ≤ MAX_UPLOAD_BYTES。
CHUNK_SIZE=4194304

# 分片上传会话有效期秒（默认 86400）。非必填。
UPLOAD_SESSION_TTL_SECS=86400

# ---------------------------------------------------------------------------
# 五、媒体任务队列 / ffmpeg
# ---------------------------------------------------------------------------

# 每用户每日任务配额，必须 > 0（默认 20）。
DAILY_QUOTA=20

# 每用户并发任务上限，必须 > 0（默认 2）。
MAX_CONCURRENT_TASKS_PER_USER=2

# 单任务超时秒（默认 600，requirements §8.4 的 10min）。
TASK_TIMEOUT_SECS=600

# 崩溃恢复阈值：processing 超过 N 分钟判定为 failed（默认 15）。非必填。
PROCESSING_STALE_MINUTES=15

# TTL 清理轮询间隔秒（默认 300）。非必填。
CLEANUP_INTERVAL_SECS=300

# ffmpeg / ffprobe 可执行文件（默认 ffmpeg / ffprobe；镜像内已 apt 装好）。
# 若自备静态编译版可写绝对路径。
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# 空跑开关：1=不调用真实 ffmpeg，只走全链路（本机无 ffmpeg 时调试用，默认 0）。
# ⚠️ 生产必须为 0，否则视频/图片任务不会真正处理。
MEDIA_DRY_RUN=0

# 水印/字幕用的 CJK 字体路径（默认下面这行，由镜像内 fonts-noto-cjk 提供）。
WATERMARK_FONT_FILE=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc

# ---------------------------------------------------------------------------
# 六、汇率上游（GET /fx/rates）
# ---------------------------------------------------------------------------

# 上游汇率 base URL（默认 https://api.er-api.com/v6/latest）。非必填。
FX_RATES_URL=https://open.er-api.com/v6/latest

# 【密钥】汇率数据源 API Key：仅从环境变量注入，切勿提交真实值。
# 留空 → GET /fx/rates 返回 503 并提示「未配置数据源」（对应工具前端置 offline）。
FX_API_KEY=

# 汇率缓存秒数（默认 900 = 15min，requirements §6.4）。非必填。
FX_CACHE_SECS=900

# 请求上游的超时秒（默认 8）。非必填。
FX_TIMEOUT_SECS=8

# ---------------------------------------------------------------------------
# 七、跨域调试代理（POST /dev/proxy）
# ---------------------------------------------------------------------------

# 代理响应体上限字节，必须 > 0（默认 5242880）。超限按 truncated:true 截断。
PROXY_MAX_RESPONSE_BYTES=5242880

# 代理请求超时秒（默认 15）。非必填。
PROXY_TIMEOUT_SECS=15

# ⚠️ 危险开关：1=允许访问私网/内网地址（仅限本机调试 SSRF 相关行为）。
# 生产必须为 false/0，否则等于开放内网穿透。默认 false。
PROXY_ALLOW_PRIVATE_NETWORK=false

# ---------------------------------------------------------------------------
# 八、以下变量不经过 apply_env，由代码/编排单独读取
# ---------------------------------------------------------------------------

# 可选配置文件路径（src/config.rs::FileSettings::from_config_file，默认 ./config.toml；
# 文件里不允许出现 database_url / jwt_secret / wechat_appsecret / fx_api_key）。
CONFIG_FILE=

# 队列 worker 并发数（src/tasks/queue.rs::worker_count，默认 2，范围 1..MAX_WORKERS）。
TASK_WORKERS=2

# 汇率上游 base 覆盖（src/fx/mod.rs::ENV_FX_API_BASE）；不设则用 FX_RATES_URL。
FX_API_BASE=

# --- docker compose 专用（Rust 代码不读取；compose 据此拼 DATABASE_URL 并初始化 PG）---
# 密钥同样只从本机 .env 注入，切勿提交真实值。
POSTGRES_USER=CHANGE_ME_USER
POSTGRES_PASSWORD=CHANGE_ME_ONLY_FROM_ENV
POSTGRES_DB=toolbox

# 宿主机映射端口：api 的 8080（如需改宿主端口改这里），以及可选的 PG 直连端口。
API_HOST_PORT=8080
PG_HOST_PORT=15434

# 磁盘映射热更新栈（docker-compose.update.yml / scripts/update.sh）专用：
# 容器内访问宿主机开发库必须写 host.docker.internal，写 127.0.0.1 会连到容器自己。
#   DEV_DATABASE_URL=postgresql://USER:PASSWORD@host.docker.internal:15433/toolbox_dev
# 该栈是开发/联调用途：WECHAT_STUB 默认 1（不请求微信）、MEDIA_DRY_RUN 默认 0（用镜像内真 ffmpeg）。
# DEV_API_HOST_PORT=8081
# DEV_LOG_LEVEL=info
# DEV_PROXY_ALLOW_PRIVATE_NETWORK=false
